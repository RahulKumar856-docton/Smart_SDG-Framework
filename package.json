{
  "name": "smart-sdg-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Smart SDG Monitoring Framework",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "gunicorn app:app --bind 0.0.0.0:${PORT:-5000} || python app.py",
    "build": "bash build.sh",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "client:dev": "npm --prefix client dev",
    "client:build": "npm --prefix client run build"
  }
}
